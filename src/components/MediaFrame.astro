---
interface Props {
  aspectRatio?: string; // e.g. "aspect-video", "aspect-[4/5]", "aspect-[16/9]"
  label: string;
  metadata?: string;
  variant?: 'architecture' | 'bridge' | 'grid' | 'transit';
  altText: string;
  imageSrc?: string;
}

const {
  aspectRatio = 'aspect-video',
  label,
  metadata = 'NYC VISUAL SPEC',
  variant = 'architecture',
  altText,
  imageSrc,
} = Astro.props;
---

<div class="relative group w-full hairline-all bg-neutral-950/40 overflow-hidden flex flex-col justify-between p-3 sm:p-5 reveal img-scale" role="img" aria-label={altText}>
  {imageSrc ? (
    <!-- Real Image Render (Full Native Color) -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img
        src={imageSrc}
        alt={altText}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <!-- Background SVG Graphic pattern for placeholder -->
    <div class="absolute inset-0 opacity-20 pointer-events-none transition-opacity group-hover:opacity-35">
      {variant === 'architecture' && (
        <svg class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" preserveAspectRatio="none">
          <defs>
            <pattern id="grid-pattern" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" class="text-primary"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-pattern)" />
          <line x1="0" y1="300" x2="400" y2="0" stroke="currentColor" stroke-width="1" class="text-primary" />
          <line x1="0" y1="150" x2="400" y2="150" stroke="currentColor" stroke-width="0.5" stroke-dasharray="4,4" class="text-ruby" />
        </svg>
      )}

      {variant === 'bridge' && (
        <svg class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" preserveAspectRatio="none">
          <path d="M 0 50 Q 200 250 400 50" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary" />
          <path d="M 0 80 Q 200 280 400 80" fill="none" stroke="currentColor" stroke-width="0.75" class="text-secondary" />
          {Array.from({ length: 12 }).map((_, i) => (
            <line x1={i * 35} y1="0" x2={i * 35} y2="300" stroke="currentColor" stroke-width="0.5" class="text-primary" />
          ))}
        </svg>
      )}

      {variant === 'transit' && (
        <svg class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" preserveAspectRatio="none">
          <rect x="20" y="20" width="360" height="260" fill="none" stroke="currentColor" stroke-width="1" class="text-primary" />
          <circle cx="200" cy="150" r="80" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="6,3" class="text-ruby" />
          <line x1="200" y1="0" x2="200" y2="300" stroke="currentColor" stroke-width="0.5" class="text-secondary" />
        </svg>
      )}

      {variant === 'grid' && (
        <svg class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" preserveAspectRatio="none">
          {Array.from({ length: 8 }).map((_, i) => (
            <line x1="0" y1={i * 40} x2="400" y2={i * 40} stroke="currentColor" stroke-width="0.5" class="text-primary" />
          ))}
          {Array.from({ length: 10 }).map((_, i) => (
            <line x1={i * 40} y1="0" x2={i * 40} y2="300" stroke="currentColor" stroke-width="0.5" class="text-primary" />
          ))}
        </svg>
      )}
    </div>
  )}

  <div class={`${aspectRatio} w-full relative z-10 flex flex-col justify-between p-2`}>
    <!-- Top Metadata Badge -->
    <div class="flex items-center justify-between font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary">
      <span class="bg-bg/90 px-2 py-0.5 border border-rule text-primary font-semibold">{metadata}</span>
      <span class="text-secondary font-mono bg-bg/90 px-2 py-0.5 border border-rule">[ PROJECT SPEC ]</span>
    </div>

    <!-- Bottom Visible Label -->
    <div class="flex flex-col gap-1 font-mono text-xs sm:text-sm uppercase tracking-wider text-primary bg-bg/90 p-3 border border-rule backdrop-blur-sm">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-ruby rounded-full"></span>
          <span class="font-bold text-primary">{label}</span>
        </div>
      </div>
      <span class="text-[10px] text-secondary font-medium">VISUAL & PRODUCTION ARCHIVE</span>
    </div>
  </div>
</div>
